import assert from "node:assert/strict";
import { mock, test } from "node:test";
import { NextRequest } from "next/server";
const id="11111111-1111-4111-8111-111111111111";
const endpoint=`https://preview.example.test/api/admin/integration-recommendations/${id}/review`;
const body={status:"in_review",reason:"Begin a private read-only review.",expectedVersion:0,requestId:"22222222-2222-4222-8222-222222222222"};
let authenticated=true, available=true, failure=false, fetches=0, reads=0, writes=0;
let row:Record<string,unknown>={id,status:"new",reviewVersion:0,reviewReason:null,reviewActor:null,reviewedAt:null,reviewRequestId:null};
const columns={id:"id",reviewVersion:"version"};
mock.method(globalThis,"fetch",async()=>{fetches++;throw new Error("External calls forbidden")});
mock.module(new URL("../app/admin/auth.ts",import.meta.url).href,{namedExports:{getAdminIdentity:async()=>authenticated?{method:"password",username:"synthetic-admin",displayName:"Synthetic"}:null}});
mock.module(new URL("../db/schema.ts",import.meta.url).href,{namedExports:{integrationRecommendations:columns}});
mock.module(new URL("../db/index.ts",import.meta.url).href,{namedExports:{hasDatabase:()=>available,getDb:()=>({select:()=>({from:()=>({where:()=>({limit:async()=>{reads++;if(failure)throw new Error("Private transport and owner@example.test");return [row]}})})}),update:()=>({set:(values:Record<string,unknown>)=>({where:()=>({returning:async()=>{writes++;row={...row,...values};return [row]}})})})})}});
const {POST}=await import("../app/api/admin/integration-recommendations/[id]/review/route");
const context={params:Promise.resolve({id})};
const request=(value:unknown=body,headers:Record<string,string>={})=>new Request(endpoint,{method:"POST",headers:{origin:"https://preview.example.test","content-type":"application/json",...headers},body:typeof value==="string"?value:JSON.stringify(value)});
async function expect(response:Response,status:number,error:string){assert.equal(response.status,status);assert.equal(response.headers.get("cache-control"),"no-store");assert.deepEqual(await response.json(),{error})}
test("unauthenticated review exits before proposal storage and reveals no contact or review details",async()=>{authenticated=false;try{await expect(await POST(request(),context),401,"admin_auth_required");assert.equal(reads,0);assert.equal(writes,0)}finally{authenticated=true}});
test("admin review enforces full same-origin comparison and rejects missing, foreign, downgraded or forged authorities",async()=>{for(const headers of ([{origin:"https://outside.example.test"},{origin:"http://preview.example.test"},{origin:"null"},{origin:""},{origin:"https://outside.example.test",host:"outside.example.test"}] as Record<string, string>[]))await expect(await POST(request(body,headers),context),403,"invalid_origin");assert.equal(reads,0)});
test("bounded invalid review inputs never reach storage",async()=>{for(const value of ["{",{...body,reason:"short".repeat(300)},{...body,actor:"spoofed"},{...body,status:"published"}])await expect(await POST(request(value),context),400,"invalid_request");await expect(await POST(request("x".repeat(6001),{"content-length":"1"}),context),413,"invalid_request");assert.equal(reads,0)});
test("valid admin decision stores private reviewer and timestamp and provides no applicant contact fields",async()=>{const response=await POST(request(),context);assert.equal(response.status,200);const result=await response.json();assert.equal(result.review.status,"in_review");assert.equal(result.review.version,1);assert.equal(result.review.actor,"password:synthetic-admin");assert.equal(result.replayed,false);assert.ok(result.review.reviewedAt);assert.equal(writes,1);assert.equal("email" in result.review,false);assert.equal("requestId" in result.review,false);assert.equal("url" in result.review,false)});
test("a repeated decision is idempotent and stale changes get a safe conflict",async()=>{const response=await POST(request(),context);assert.equal(response.status,200);assert.equal((await response.json()).replayed,true);assert.equal(writes,1);await expect(await POST(request({...body,reason:"Different note"}),context),409,"version_conflict");assert.equal(writes,1)});
test("NextRequest loopback normalization permits the actual same-origin authority only",async()=>{const value={...body,expectedVersion:1,requestId:"33333333-3333-4333-8333-333333333333"};const response=await POST(new NextRequest(`http://127.0.0.1:8143/api/admin/integration-recommendations/${id}/review`,{method:"POST",headers:{origin:"http://127.0.0.1:8143",host:"127.0.0.1:8143"},body:JSON.stringify(value)}),context);assert.equal(response.status,200)});
test("storage failures remain private and no auto-publishing, notifications or provider calls occur",async()=>{available=false;try{await expect(await POST(request(),context),503,"storage_unavailable")}finally{available=true}failure=true;try{await expect(await POST(request(),context),503,"review_unavailable")}finally{failure=false}assert.equal(fetches,0)});
